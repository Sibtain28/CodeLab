# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string.
# Neon: Project → Connect → copy the connection string (keep ?sslmode=require).
# Local: postgresql://USER:PASSWORD@localhost:5432/codelab
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Secret used to sign session cookies. At least 32 random characters.
# Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-string"

# The URL the app is served from.
BETTER_AUTH_URL="http://localhost:3000"
