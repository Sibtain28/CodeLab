# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string.
# Neon: Project → Connect → copy the connection string (keep ?sslmode=require).
# Local: postgresql://USER:PASSWORD@localhost:5432/codelab
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Secret used to sign session cookies. At least 32 random characters.
# Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-string"

# The URL the app is served from.
BETTER_AUTH_URL="http://localhost:3000"

# Live collaboration (Phase 4). The browser connects to this WebSocket URL;
# start the server with `npm run collab`. Leave empty to turn live editing off
# (the editor then works as before: local edits + ⌘S saves).
COLLAB_URL="ws://localhost:1234"

# Optional, used by the collab server (`npm run collab`):
# COLLAB_PORT=1234
# Comma-separated browser origins allowed to connect (default: BETTER_AUTH_URL's origin).
# COLLAB_ALLOWED_ORIGINS="http://localhost:3000"

# Audio/video calls (Phase 5) — LiveKit. From LiveKit Cloud: Project → Settings → Keys.
# Without these, calls show "not set up" and everything else keeps working.
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="your-api-key"
# Server-only. Never expose it to the browser or commit it.
LIVEKIT_API_SECRET="your-api-secret"
